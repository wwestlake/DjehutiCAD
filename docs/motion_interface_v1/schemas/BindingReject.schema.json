{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://djehuti.local/motion/v1/BindingReject.schema.json",
  "title": "BindingReject",
  "description": "DEWB -> DCAD: incompatibilities in the proposed profile.",
  "type": "object",
  "properties": {
    "type": {
      "const": "BindingReject"
    },
    "profileRevision": {
      "type": "integer"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/error"
      }
    }
  },
  "required": [
    "type",
    "profileRevision",
    "errors"
  ]
}
