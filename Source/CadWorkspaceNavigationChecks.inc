std::unique_ptr<juce::DocumentWindow> createNavigationCheckWindow()
{
    using namespace djehuti::cad;auto service=std::make_shared<CadCommandService>();juce::String body,cylinder,error;service->createBox(60,80,50,body,error);service->createCylinder(25,70,cylinder,error);service->setPlacement(cylinder,160,0,0,0,0,0,error);
