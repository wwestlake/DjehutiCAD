    {const auto handler=view.onWorkspaceKey;bool delegated=false;view.onWorkspaceKey=[&](const auto&){delegated=true;return true;};view.keyPressed(juce::KeyPress('A',juce::ModifierKeys::ctrlModifier,'A'));check(delegated,"Fly movement keys do not swallow modified CAD shortcuts");view.onWorkspaceKey=handler;}
